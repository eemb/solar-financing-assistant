# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# App
LOG_LEVEL=INFO

# Financing — monthly interest rate applied to all simulations
MONTHLY_RATE=0.019

# Solar project estimation defaults
GENERATION_PER_KWP_MONTH=120.0
COST_PER_KWP_BRL=5000.00

# HTTP — timeout in seconds for all outbound HTTP calls (address/solar gateways)
HTTP_TIMEOUT_SECONDS=10.0

# OCR provider used to read energy bills.
# Use "mock" for demo without local OCR dependencies.
# Use "tesseract" after installing tesseract-ocr and tesseract-ocr-por locally.
OCR_PROVIDER=mock

# Application mode.
# Use "cli" (default) for the traditional terminal menu.
# Use "agent" to run the OpenAI-powered conversational assistant.
APP_MODE=cli
